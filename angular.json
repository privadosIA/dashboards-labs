    "api-client": {
      "projectType": "library",
      "root": "libs/api-client",
      "sourceRoot": "libs/api-client/src",
      "prefix": "lab",
      "architect": {
        "build": {
          "builder": "@angular-devkit/architect:true",
          "options": {},
          "configurations": {
            "development": {}
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "include": [
              "**/*.spec.ts"
            ],
            "runnerConfig": "libs/api-client/vitest.config.mts",
            "coverageReporters": [
              "lcov",
              "text-summary"
            ]
          }
        }
      }
    },
