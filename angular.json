    "dashboard-full": {
      "projectType": "application",
      "root": "apps/dashboard-full",
      "sourceRoot": "apps/dashboard-full/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "loader": {
              ".ttf": "file"
            },
            "browser": "apps/dashboard-full/src/main.ts",
            "tsConfig": "apps/dashboard-full/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/dashboard-full/public"
              },
              {
                "glob": "swagger-ui.css",
                "input": "node_modules/swagger-ui-dist",
                "output": "swagger-ui"
              }
            ],
            "styles": [
              "@fontsource/material-symbols-outlined/400.css",
              "@fontsource-variable/plus-jakarta-sans/index.css",
              "@fontsource-variable/geist/index.css",
              "apps/dashboard-full/src/styles.scss",
              "apps/dashboard-full/src/tailwind.css"
            ],
            "outputPath": "dist/dashboard-full",
            "polyfills": [
              "@angular/localize/init"
            ],
            "allowedCommonJsDependencies": [
              "swagger-ui-dist"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "apps/dashboard-full/ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "tutorial": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "apps/dashboard-full/src/environments/environment.ts",
                  "with": "apps/dashboard-full/src/environments/environment.tutorial.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "apps/dashboard-full/proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "dashboard-full:build:production"
            },
            "development": {
              "buildTarget": "dashboard-full:build:development"
            },
            "tutorial": {
              "buildTarget": "dashboard-full:build:tutorial"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "apps/dashboard-full/tsconfig.spec.json",
            "runner": "vitest",
            "coverageReporters": [
              "lcov",
              "text-summary"
            ],
            "setupFiles": [
              "apps/dashboard-full/src/test-setup.ts"
            ]
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "dashboard-full:build"
          }
        }
      },
      "i18n": {
        "sourceLocale": "en"
      }
    },
