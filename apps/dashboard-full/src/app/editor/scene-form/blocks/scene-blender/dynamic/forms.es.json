{
  "version": "1.0",
  "id": "blender-idea",
  "layout": { "columns": 12 },
  "fields": [
    {
      "key": "idea",
      "type": "textarea",
      "label": "Qué muestra la escena",
      "description": "Una idea en tus palabras; con una descripción ya escrita, lo que quieres cambiar (por ejemplo «la cámara más lejos»).",
      "layout": { "col": 12 },
      "validation": { "maxLength": 2000 },
      "props": { "rows": 3, "attributes": { "data-testid": "blender-idea" } }
    },
    {
      "key": "seconds",
      "type": "number",
      "label": "Duración de la escena (s)",
      "layout": { "col": 4 },
      "validation": { "min": 0.5, "max": 600 },
      "props": { "attributes": { "data-testid": "blender-seconds", "min": 0.5, "max": 600, "step": 0.5 } }
    }
  ]
}
