{
  "version": "1.0",
  "id": "blender-idea",
  "layout": { "columns": 12 },
  "fields": [
    {
      "key": "idea",
      "type": "textarea",
      "label": "What the scene shows",
      "description": "An idea in your own words; with a description already written, what you want to change (for example “the camera further away”).",
      "layout": { "col": 12 },
      "validation": { "maxLength": 2000 },
      "props": { "rows": 3, "attributes": { "data-testid": "blender-idea" } }
    },
    {
      "key": "seconds",
      "type": "number",
      "label": "Length of the scene (s)",
      "layout": { "col": 4 },
      "validation": { "min": 0.5, "max": 600 },
      "props": { "attributes": { "data-testid": "blender-seconds", "min": 0.5, "max": 600, "step": 0.5 } }
    }
  ]
}
