          "props": {
            "attributes": {
              "data-testid": "scene-seed"
            }
          }
        },
        {
          "key": "lora",
          "type": "select",
          "label": "lora",
          "options": {
            "source": "remote",
            "endpoint": "scene:loras"
          },
          "logic": {
            "showWhen": {
              "field": "ctx.generated",
              "operator": "truthy"
            }
          },
          "props": {
            "attributes": {
              "data-testid": "scene-lora"
            }
          }
        },
        {
          "key": "variants",
          "type": "number",
          "label": "variants",
          "props": {
            "attributes": {
              "data-testid": "scene-variants",
