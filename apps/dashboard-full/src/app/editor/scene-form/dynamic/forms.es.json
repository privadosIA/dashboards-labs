        {
          "value": "static",
          "label": "static"
        },
        {
          "value": "zoom_in",
          "label": "zoom_in"
        },
        {
          "value": "zoom_out",
          "label": "zoom_out"
        },
        {
          "value": "pan_left",
          "label": "pan_left"
        },
        {
          "value": "pan_right",
          "label": "pan_right"
        },
        {
          "value": "handheld",
          "label": "handheld"
        },
        {
          "value": "rotate_cw",
          "label": "rotate_cw"
        },
        {
          "value": "rotate_ccw",
          "label": "rotate_ccw"
        }
      ],
      "props": {
        "attributes": {
          "data-testid": "scene-motion-type"
