              },
              "logic": {
                "showWhen": {
                  "field": "ctx.animates",
                  "operator": "truthy"
                }
              }
            },
            {
              "key": "animation.frames",
              "type": "number",
              "label": "Animación: fotogramas",
              "props": {
                "attributes": {
                  "min": 1,
                  "data-testid": "scene-anim-frames"
                }
              },
              "logic": {
                "showWhen": {
                  "field": "ctx.animates",
                  "operator": "truthy"
                }
              }
            },
            {
              "key": "animation.steps",
              "type": "number",
              "label": "Animación: steps",
              "props": {
                "attributes": {
                  "min": 1,
                  "data-testid": "scene-anim-steps"
                }
              },
              "logic": {
                "showWhen": {
                  "field": "ctx.animates",
                  "operator": "truthy"
                }
              }
            }
          ],
          "logic": {
            "showWhen": {
              "field": "ctx.animates",
              "operator": "truthy"
            }
          }
        }
      ]
    },
