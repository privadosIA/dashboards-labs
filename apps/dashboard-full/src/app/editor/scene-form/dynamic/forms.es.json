          "cssClass": "df-group--plain",
          "fields": [
            {
              "key": "render.resolution",
              "type": "text",
              "label": "Resolución",
              "props": {
                "attributes": {
                  "data-testid": "scene-render-resolution"
                }
              }
            },
            {
              "key": "render.steps",
              "type": "number",
              "label": "Steps",
              "props": {
                "attributes": {
                  "min": 1,
                  "data-testid": "scene-render-steps"
                }
              }
