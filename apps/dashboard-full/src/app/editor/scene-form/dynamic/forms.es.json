{
  "version": "1.0",
  "id": "scene",
  "layout": {
    "columns": 1
  },
  "fields": [
    {
      "key": "narration",
      "type": "hidden"
    },
    {
      "key": "pictureMode",
      "type": "hidden"
    },
    {
      "key": "overlayOn",
      "type": "hidden"
    },
    {
      "key": "slots.serverError",
      "type": "slot",
      "props": {
