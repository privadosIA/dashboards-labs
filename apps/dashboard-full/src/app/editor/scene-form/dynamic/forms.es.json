      },
      "props": {
        "attributes": {
          "data-testid": "scene-id"
        }
      },
      "validation": {
        "validators": [
          {
            "name": "sceneRule",
            "args": {
              "rule": "id"
            }
          }
        ]
      }
    },
    {
      "key": "slots.preview",
      "type": "slot",
      "props": {
        "slot": "preview"
      },
      "layout": {
        "col": 12
      },
      "logic": {
        "showWhen": {
          "field": "ctx.video",
          "operator": "truthy"
        }
      }
    },
    {
      "key": "slots.picture",
      "type": "slot",
      "props": {
        "slot": "picture"
      },
      "layout": {
        "col": 12
      },
      "logic": {
        "showWhen": {
          "field": "ctx.video",
          "operator": "truthy"
        }
      }
    },
    {
      "key": "slots.motionPart",
      "type": "slot",
      "props": {
        "slot": "motionPart"
      },
      "layout": {
        "col": 12
      },
      "logic": {
        "showWhen": {
          "all": [
            {
              "field": "ctx.video",
              "operator": "truthy"
            },
            {
              "field": "pictureMode",
              "operator": "eq",
              "value": "part"
            }
          ]
        }
      }
    },
    {
      "key": "motion_graphic",
      "type": "textarea",
      "label": "Qué muestra el gráfico",
      "description": "Una página animada que escribe el modelo y dibuja Chrome, tan larga como la narración. Títulos, listas, gráficos, esquemas.",
      "layout": {
        "col": 12
      },
      "props": {
        "rows": 3,
        "attributes": {
          "data-testid": "motion-graphic"
        }
      },
      "logic": {
        "showWhen": {
          "all": [
            {
              "field": "ctx.video",
              "operator": "truthy"
            },
            {
              "any": [
                {
                  "field": "pictureMode",
                  "operator": "eq",
                  "value": "motion"
                },
                {
                  "field": "ctx.autoPart",
                  "operator": "truthy"
                }
              ]
            }
          ]
        }
      },
      "validation": {
        "validators": [
          {
            "name": "sceneRule",
            "args": {
              "rule": "motionGraphic"
            }
          }
        ]
      }
    },
    {
      "key": "slots.pictureSource",
      "type": "slot",
      "props": {
        "slot": "pictureSource"
      },
      "layout": {
        "col": 12
      },
      "logic": {
        "showWhen": {
          "field": "ctx.video",
          "operator": "truthy"
        }
      }
    },
    {
      "key": "slots.pictures",
