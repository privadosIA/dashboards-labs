{
  "version": "1.0",
  "id": "motion-edit-scene",
  "layout": {
    "columns": 1
  },
  "fields": [
    {
      "key": "brief",
      "type": "textarea",
      "label": "Idea o metáfora",
      "props": {
        "rows": 3
      },
      "validation": {
        "maxLength": 500,
        "messages": {
          "maxLength": "Como mucho 500 caracteres."
        }
      }
    },
    {
      "key": "review",
      "type": "checkbox",
      "label": "Revisar con el modelo de visión",
      "defaultValue": true
    },
    {
      "key": "reviewMin",
      "type": "number",
      "label": "Nota mínima (1 a 10)",
      "defaultValue": 7,
      "validation": {
        "min": 1,
        "max": 10,
        "messages": {
          "min": "De 1 a 10.",
          "max": "De 1 a 10."
        }
      },
      "logic": {
        "showWhen": {
          "field": "review",
          "operator": "eq",
          "value": true
        }
      }
    },
    {
      "key": "reviewAttempts",
      "type": "number",
      "label": "Reescrituras como mucho (0 a 3)",
      "defaultValue": 2,
      "validation": {
        "min": 0,
        "max": 3,
        "messages": {
          "min": "De 0 a 3.",
          "max": "De 0 a 3."
        }
      },
      "logic": {
        "showWhen": {
          "field": "review",
          "operator": "eq",
          "value": true
        }
      }
    }
  ]
}
