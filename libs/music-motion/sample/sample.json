    {
      "name": "confetti-burst",
      "description": "Confetti that bursts from the bottom on the loud beats",
      "manifest": {
        "name": "confetti-burst",
        "description": "Confetti that bursts from the bottom on the loud beats",
        "version": 1,
        "cost_ms": 60,
        "levels": [
          "simple",
          "medium",
          "advanced"
        ],
        "params": [
          {
            "name": "count",
            "type": "int",
            "default": "24",
            "min": 4,
            "max": 60
          },
          {
            "name": "spread",
            "type": "number",
            "default": "1",
            "min": 0.2,
            "max": 2,
            "animatable": true
          }
        ]
      },
      "fragment": "<style>#cb{position:absolute;inset:0;overflow:hidden}#cb i{position:absolute;bottom:0;width:1.2%;height:2.4%;background:var(--accent);opacity:0}#cb i:nth-child(3n){background:var(--fg)}</style>\n<div id=\"cb\"></div>\n<script>\n(function () {\n  var p = window.__params || {};\n  var count = Math.max(4, Math.min(60, parseInt(p.count, 10) || 24));\n  var root = document.getElementById('cb');\n  var bits = [];\n  for (var i = 0; i < count; i++) {\n    var el = document.createElement('i');\n    root.appendChild(el);\n    bits.push({ el: el, x: ((i * 37) % 100) / 100, v: 0.5 + ((i * 53) % 50) / 100, d: ((i * 29) % 100) / 100 - 0.5 });\n  }\n  window.__partSeek = function (t, beat) {\n    var spread = Number(p.spread) || 1;\n    var n = beat && beat.number >= 0 ? beat.number : 0;\n    var pos = beat && beat.position ? beat.position : 0;\n    var age = pos + (n % 4 === 0 ? 0 : 1);\n    bits.forEach(function (b) {\n      var life = age / 2;\n      var up = Math.sin(Math.min(1, life) * Math.PI) * 70 * b.v;\n      b.el.style.left = (b.x * 100 + b.d * 30 * spread * life) + '%';\n      b.el.style.bottom = up + '%';\n      b.el.style.opacity = life < 1 ? 1 - life * 0.6 : 0;\n      b.el.style.transform = 'rotate(' + Math.round(life * 360 * b.d) + 'deg)';\n    });\n  };\n})();\n</script>"
    },
    {
      "name": "ticker-tape",
