      },
      "fragment": "<style>#tt{position:absolute;left:0;right:0;bottom:6%;height:9%;overflow:hidden;background:var(--accent);color:var(--bg);font-family:var(--display);white-space:nowrap}#tt span{position:absolute;top:0;line-height:2.4;font-size:3.4vh;letter-spacing:.1em}</style>\n<div id=\"tt\"><span id=\"tt-run\"></span></div>\n<script>\n(function () {\n  var p = window.__params || {};\n  var text = String(p.text || 'LIVE • ON AIR • LIVE •');\n  var run = document.getElementById('tt-run');\n  run.textContent = text + '  ' + text + '  ' + text;\n  window.__partSeek = function (t) {\n    var speed = Number(p.speed) || 1;\n    var width = run.scrollWidth / 3 || 1;\n    run.style.left = (-((t * 120 * speed) % width)) + 'px';\n  };\n})();\n</script>"
    },
    {
      "name": "pulse-ring",
      "description": "Rings that expand from the centre on every beat",
      "manifest": {
        "name": "pulse-ring",
        "description": "Rings that expand from the centre on every beat",
        "version": 1,
        "cost_ms": 55,
        "levels": [
          "simple",
          "medium",
