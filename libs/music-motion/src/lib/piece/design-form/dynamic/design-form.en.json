{
  "version": "1.0",
  "id": "design-form",
  "layout": {
    "columns": 1
  },
  "fields": [
    {
      "key": "dark",
      "type": "text",
      "label": "Dark colour",
      "validation": {
        "required": true,
        "pattern": "^#[0-9a-fA-F]{6}$",
        "messages": {
          "required": "Write the colour like #aabbcc.",
          "pattern": "Write the colour like #aabbcc."
        }
      },
      "layout": {
        "cssClass": "color-field"
      }
    },
    {
      "key": "light",
      "type": "text",
      "label": "Light colour",
      "validation": {
        "required": true,
        "pattern": "^#[0-9a-fA-F]{6}$",
        "messages": {
          "required": "Write the colour like #aabbcc.",
          "pattern": "Write the colour like #aabbcc."
        }
      },
      "layout": {
        "cssClass": "color-field"
      }
    },
    {
      "key": "display",
      "type": "select",
      "label": "Typeface for big words",
      "layout": {
        "cssClass": "font-field"
      }
    },
    {
      "key": "body",
      "type": "select",
      "label": "Typeface for the verse",
      "layout": {
        "cssClass": "font-field"
      }
    },
    {
      "key": "accent",
      "type": "text",
      "label": "Accent colour",
      "validation": {
        "required": true,
        "pattern": "^#[0-9a-fA-F]{6}$",
        "messages": {
          "required": "Write the colour like #aabbcc.",
          "pattern": "Write the colour like #aabbcc."
        }
      },
      "layout": {
        "cssClass": "color-field"
      }
    },
    {
      "key": "verseStyle",
      "type": "select",
      "label": "How a verse is marked while it is sung",
      "defaultValue": "plain",
      "layout": {
        "cssClass": "style-field"
      }
    },
    {
      "key": "hitStyle",
      "type": "select",
      "label": "How a word hit looks",
      "defaultValue": "plain",
      "layout": {
        "cssClass": "style-field"
      }
    },
    {
      "type": "slot",
      "name": "accentProblem"
    },
    {
      "key": "defaultMode",
      "type": "radio",
      "label": "Mode by default",
      "defaultValue": "dark",
      "props": {
        "inline": true
      },
      "layout": {
        "cssClass": "mode-field"
      }
    }
  ]
}
