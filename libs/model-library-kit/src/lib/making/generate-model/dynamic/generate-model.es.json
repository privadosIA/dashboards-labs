{
  "version": "1.0",
  "id": "generate-model",
  "layout": {
    "columns": 1
  },
  "fields": [
    {
      "key": "prompt",
      "type": "textarea",
      "label": "Qué objeto es",
      "description": "Un solo objeto: su forma, material, color y acabado. Hasta 1000 caracteres.",
      "validation": {
        "required": true,
        "maxLength": 1000,
        "messages": {
          "required": "Describe el objeto.",
          "maxLength": "Como mucho 1000 caracteres."
        }
      },
      "props": {
        "rows": 3,
        "attributes": {
          "data-testid": "generate-prompt"
        }
      }
    },
    {
      "key": "engine",
      "type": "select",
      "label": "Motor",
      "defaultValue": "triposr",
      "options": [
        {
          "value": "triposr",
          "label": "TripoSR (MIT)"
        },
        {
          "value": "sf3d",
          "label": "Stable Fast 3D"
        }
      ],
      "props": {
        "attributes": {
          "data-testid": "generate-engine"
        }
      }
    },
    {
      "key": "detail",
      "type": "select",
      "label": "Detalle",
      "defaultValue": "normal",
      "options": [
        {
          "value": "low",
          "label": "Bajo"
        },
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "high",
          "label": "Alto"
        }
      ],
      "props": {
        "attributes": {
          "data-testid": "generate-detail"
        }
      }
    },
    {
      "key": "name",
      "type": "text",
      "label": "Nombre (opcional)",
      "description": "Letras minúsculas, dígitos, puntos, guiones bajos y guiones; si se deja vacío se hace uno a partir del texto.",
      "validation": {
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
        "messages": {
          "pattern": "Letras minúsculas, dígitos, puntos, guiones bajos y guiones, hasta 64."
        }
      },
      "props": {
        "attributes": {
          "data-testid": "generate-name"
        }
      }
    },
    {
      "key": "adult",
      "type": "checkbox",
      "label": "Para mayores de 18 años",
      "defaultValue": false,
      "props": {
        "attributes": {
          "data-testid": "generate-adult"
        }
      }
    }
  ]
}
